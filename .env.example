# ============================================================================
# PLANEX Cuba — variables de compilación de la SPA (plantilla).
#
# Copie a .env.local para compilar en local. Estas variables son PÚBLICAS:
# sus valores quedan disponibles en el código compilado que descarga el
# navegador. NUNCA ponga aquí una clave sb_secret_, service_role, la
# contraseña de PostgreSQL ni contraseñas de usuarios: la SPA solo usa la
# clave publicable y la protección real reside en Supabase Auth y en las
# políticas RLS del servidor.
# ============================================================================

# Proyecto Supabase (Dashboard → Settings → API):
NEXT_PUBLIC_SUPABASE_URL=https://huxxoiifdnmmrxcdxith.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXX

# Correos internos de las cuentas de colaborador creadas en Supabase Auth.
# El login de la interfaz pide el ALIAS (Colaborador1/Colaborador2); la app
# lo normaliza y resuelve al correo correspondiente antes de llamar a
# Supabase Auth (correo + contraseña). Los alias admitidos son las claves
# del mapa interno: colaborador1 / colaborador2.
NEXT_PUBLIC_PLANEX_COLABORADOR1_EMAIL=colaborador1@planex.app
NEXT_PUBLIC_PLANEX_COLABORADOR2_EMAIL=colaborador2@planex.app

# Prefijo de ruta para desplegar bajo un subdirectorio (GitHub Pages).
# En local déjelo vacío; en el flujo de GitHub Actions se define /PlanNegocios.
# NEXT_PUBLIC_BASE_PATH=/PlanNegocios
